# Redis (for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="info"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100