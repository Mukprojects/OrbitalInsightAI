# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="orbital-insight-super-secret-jwt-key-2024"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# External APIs (using demo keys - replace with real ones)
CELESTRAK_API_KEY=""
SPACE_TRACK_USERNAME=""
SPACE_TRACK_PASSWORD=""
NASA_API_KEY="DEMO_KEY"
