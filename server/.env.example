# Database
DATABASE_URL="postgresql://username:password@localhost:5432/orbital_insight_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# External APIs
CELESTRAK_API_KEY="your-celestrak-api-key"
SPACE_TRACK_USERNAME="your-space-track-username"
SPACE_TRACK_PASSWORD="your-space-track-password"
NASA_API_KEY="your-nasa-api-key"
NOAA_API_KEY="your-noaa-space-weather-api-key"

# Redis (for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Logging
LOG_LEVEL="info"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100